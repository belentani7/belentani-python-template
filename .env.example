# {{cookiecutter.project_name}} — Environment Variables
# Copia este archivo a .env y completa los valores
# NUNCA commitees el archivo .env real

# App
APP_NAME={{cookiecutter.project_name}}
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/{{cookiecutter.project_slug}}
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional: Sentry
# SENTRY_DSN=https://xxx@sentry.io/xxx

# Optional: OpenTelemetry
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
